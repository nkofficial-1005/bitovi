    {
      "parameters": {
        "jsCode": "let allPosts = [];\nitems.forEach(item => {\n    if (item.json.blogPosts) {\n        allPosts = allPosts.concat(item.json.blogPosts);\n    }\n});\nreturn allPosts.map(post => ({ json: { post } }));"
      },
      "id": "d8b5d211-9d7b-41ae-9df6-dc56de2991d3",
      "name": "Aggregate Blog Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        200
      ]
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "import re\nfrom bs4 import BeautifulSoup\n\ndef clean_text(text):\n    return re.sub(r'\\s+', ' ', text).strip()\n\nposts = []\n\nfor i, item in enumerate(items):\n    html = item[\"json\"][\"post\"]\n    soup = BeautifulSoup(html, \"html.parser\")\n\n    # Extract the link from the <a> tag with class \"w-full\"\n    link_tag = soup.find(\"a\", class_=\"w-full\")\n    link = link_tag[\"href\"] if link_tag and link_tag.has_attr(\"href\") else \"\"\n    \n    # Title extraction: assuming the title is within the first <p> tag inside the blog-tile-content div.\n    content = soup.find(\"div\", class_=\"blog-tile-content\")\n    title_tag = content.find(\"p\") if content else None\n    title = clean_text(title_tag.get_text()) if title_tag else \"\"\n\n    # Extract the date and time from the <time> element.\n    time_tag = soup.find(\"time\")\n    dateTime = time_tag[\"datetime\"] if time_tag and time_tag.has_attr(\"datetime\") else \"\"\n    dateDisplayed = clean_text(time_tag.get_text()) if time_tag else \"\"\n\n    # Extract the category: look for an <a> tag with a class starting with \"text-category-\"\n    category_tag = soup.find(\"a\", class_=lambda c: c and c.startswith(\"text-category-\"))\n    category = clean_text(category_tag.get_text()) if category_tag else \"\"\n\n    # Extract the summary from the 'blog-content-summary' div.\n    summary_tag = soup.find(\"div\", class_=\"blog-content-summary\")\n    summary = clean_text(summary_tag.get_text()) if summary_tag else \"\"\n\n    # Extract the author: assume it's inside a <p> with class including \"font-bold\" within blog-tile-author-info.\n    author_tag = soup.find(\"div\", class_=\"blog-tile-author-info\")\n    author = \"\"\n    if author_tag:\n        bold_tag = author_tag.find(\"p\", class_=lambda c: c and \"font-bold\" in c)\n        author = clean_text(bold_tag.get_text()) if bold_tag else \"\"\n\n    # Add the parsed post details to our list.\n    post = {\n        \"link\": link,\n        \"title\": title,\n        \"date\": dateDisplayed,\n        \"category\": category,\n        \"summary\": summary,\n        \"author\": author\n    }\n    posts.append(post)\n\n# Return the posts as a list under the 'posts' key.\nreturn [{\"json\": post} for post in posts]"
      },
